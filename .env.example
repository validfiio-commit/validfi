# ─── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/validfi?sslmode=require"

# ─── JWT Secret ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secret-here"

# ─── Google AI (Gemini) ───────────────────────────────────────
GOOGLE_AI_API_KEY="AIza..."

# ─── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── x402 Wallet Intelligence (optional) ────────────────────
# ValidFi server wallet that pays for x402 API calls (~$0.05/user)
# Must be a Base network wallet funded with USDC
# Generate: Create a new wallet, fund with ~$10 USDC on Base
# Export private key (with 0x prefix)
VALIDFI_WALLET_PRIVATE_KEY="0x..."

# ─── XMTP Integration ──────────────────────────────────────
# Secret shared between XMTP agent and Next.js backend
XMTP_API_SECRET="validfi-xmtp-secret"
# Your XMTP agent's wallet address (set after running xmtp-agent)
NEXT_PUBLIC_XMTP_AGENT_ADDRESS=""
