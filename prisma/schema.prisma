generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  wallet         String   @unique  // 0x... ethereum address (lowercase)
  ens            String?           // optional ENS name
  // Cached x402 wallet intelligence
  walletData     Json?             // portfolio, balances, analysis
  walletFetched  DateTime?         // when last fetched
  ideas          Idea[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Idea {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  oneLiner     String?
  category     String
  problem      String        @db.Text
  solution     String        @db.Text
  chain        String?       // Ethereum, Solana, Base, etc.
  tokenModel   String?       // Utility Token, Governance, NFT, etc.
  stage        String        @default("idea")
  competitors  String?       @db.Text
  audience     String?
  status       IdeaStatus    @default(DRAFT)
  report       Json?
  mintTxHash   String?       // Base tx hash of minted NFT
  mintTokenId  String?       // Token ID of minted NFT
  launch       Launch?       // Moltlaunch agent + token registration
  chatMessages ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

enum IdeaStatus {
  DRAFT
  ANALYZING
  COMPLETED
  FAILED
}

model ChatMessage {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([ideaId])
}

model Launch {
  id              String       @id @default(cuid())
  ideaId          String       @unique
  idea            Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tokenName       String
  tokenSymbol     String
  tokenAddress    String?      // ERC-20 contract address on Base
  transactionHash String?      // Deployment tx hash
  explorerUrl     String?      // Basescan link
  uniswapUrl      String?      // Uniswap trade link
  walletAddress   String?      // Moltlaunch wallet used
  agentId         String?      // Moltlaunch agent ID (ERC-8004)
  status          LaunchStatus @default(PENDING)
  error           String?
  launchData      Json?        // Full CLI response
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([ideaId])
}

enum LaunchStatus {
  PENDING
  DEPLOYING
  LIVE
  FAILED
}
