generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  wallet         String   @unique
  ens            String?
  walletData     Json?
  walletFetched  DateTime?
  ideas          Idea[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Idea {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  oneLiner     String?
  category     String
  problem      String        @db.Text
  solution     String        @db.Text
  chain        String?
  tokenModel   String?
  stage        String        @default("idea")
  competitors  String?       @db.Text
  audience     String?
  status       IdeaStatus    @default(DRAFT)
  report       Json?
  mintTxHash   String?
  mintTokenId  String?
  launch       Launch?       // Bankr token launch
  chatMessages ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

enum IdeaStatus {
  DRAFT
  ANALYZING
  COMPLETED
  FAILED
}

model ChatMessage {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([ideaId])
}

model Launch {
  id              String       @id @default(cuid())
  ideaId          String       @unique
  idea            Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tokenName       String
  tokenSymbol     String
  tokenAddress    String?      // ERC-20 contract on Base
  explorerUrl     String?      // Basescan link
  uniswapUrl      String?      // Uniswap trade link
  bankrUrl        String?      // bankr.bot/launches/{address}
  poolId          String?      // Uniswap V4 pool ID
  status          LaunchStatus @default(PENDING)
  error           String?
  launchData      Json?        // Full CLI response data
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([ideaId])
}

enum LaunchStatus {
  PENDING
  DEPLOYING
  LIVE
  FAILED
}
